# Obtain these for YOUR Telegram application from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+989123456789
# Never commit .env, session.txt or SQLite databases.
DATA_DIR=./data
# Optional, for hosts without a terminal or without a persistent disk (Botkeep, Faable, Render, ...):
# create it on your own machine with: npm run login -- --print-session
# Treat this value like a password; put it only in the host's secret/environment settings.
# TELEGRAM_SESSION=
# Optional: only serve a small health response when the host requires a port.
# PORT=8080
# Fixed administrator is 8583719429 (not configurable by environment).
